# Motor de IA — Ollama (local: http://localhost:11434 | Docker: http://ollama:11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b

# URLs permitidas para CORS (separadas por vírgula)
